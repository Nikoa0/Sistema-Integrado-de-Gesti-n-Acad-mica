{
  "realm": "siga",
  "enabled": true,
  "displayName": "SIGA IPT",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Academic administrator" },
      { "name": "TEACHER", "description": "Teacher" },
      { "name": "STUDENT", "description": "Student" }
    ]
  },
  "clients": [
    {
      "clientId": "siga-frontend",
      "name": "SIGA IPT frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["*"],
      "webOrigins": ["+"],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"]
    }
  ],
  "users": [
    {
      "username": "admin@ipt.cl",
      "email": "admin@ipt.cl",
      "firstName": "Admin",
      "lastName": "Academico",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${DEMO_ADMIN_PASSWORD}", "temporary": false }],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "docente@ipt.cl",
      "email": "docente@ipt.cl",
      "firstName": "Docente",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${DEMO_TEACHER_PASSWORD}", "temporary": false }],
      "realmRoles": ["TEACHER"]
    },
    {
      "username": "estudiante@ipt.cl",
      "email": "estudiante@ipt.cl",
      "firstName": "Estudiante",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "${DEMO_STUDENT_PASSWORD}", "temporary": false }],
      "realmRoles": ["STUDENT"]
    }
  ]
}
